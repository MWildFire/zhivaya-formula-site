    {
      "id": "C09-Q3",
      "kind": "application",
      "prompt": "Какое количество вещества содержится в 36 г H₂O при M = 18 г/моль?",
      "options": [
        {
          "id": "o1",
          "text": "18 моль"
        },
        {
          "id": "o2",
          "text": "648 моль"
        },
        {
          "id": "o3",
          "text": "0,5 моль"
        },
        {
          "id": "o4",
          "text": "2 моль"
        }
      ],
      "correctOptionId": "o4",
      "explanation": "Используем n = m / M: 36 г / (18 г/моль) = 2 моль. Единицы граммов сокращаются.",
      "lessonAnchor": "разобранный-пример",
      "sourceUrl": "https://openstax.org/books/chemistry-2e/pages/3-1-formula-mass-and-the-mole-concept"
    },
    {
      "id": "C09-Q4",
      "kind": "application",
      "prompt": "Какова масса 0,5 моль CO₂ при M = 44 г/моль?",
      "options": [
        {
          "id": "o1",
          "text": "22 г"
        },
        {
          "id": "o2",
          "text": "88 г"
        },
        {
          "id": "o3",
          "text": "44,5 г"
        },
        {
          "id": "o4",
          "text": "0,5 г"
        }
      ],
      "correctOptionId": "o1",
      "explanation": "Из n = m / M получаем m = n × M: 0,5 моль × 44 г/моль = 22 г.",
      "lessonAnchor": "разобранный-пример",
      "sourceUrl": "https://openstax.org/books/chemistry-2e/pages/3-1-formula-mass-and-the-mole-concept"
    },
    {
      "id": "C09-Q5",
      "kind": "misconception",
      "prompt": "Один моль H₂ и один моль O₂ обязательно имеют одинаковую массу?",
